{
  "dashboard": {
    "id": null,
    "uid": null,
    "title": "Config Server - Monitoramento",
    "tags": ["spring-boot", "prometheus"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "type": "graph",
        "title": "Requisições HTTP por segundo",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{application=\"config-server\"}[1m])) by (uri)",
            "legendFormat": "{{uri}}",
            "interval": ""
          }
        ],
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
      },
      {
        "type": "graph",
        "title": "Tempo de resposta HTTP (ms)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "avg(http_server_requests_seconds_sum{application=\"config-server\"}) / avg(http_server_requests_seconds_count{application=\"config-server\"}) * 1000",
            "legendFormat": "Tempo médio",
            "interval": ""
          }
        ],
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
      },
      {
        "type": "graph",
        "title": "Uso de memória (MB)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{application=\"config-server\"} / 1024 / 1024",
            "legendFormat": "{{area}}",
            "interval": ""
          }
        ],
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
      },
      {
        "type": "stat",
        "title": "Status de Saúde",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "up{job=\"config-server\"}",
            "legendFormat": "Status",
            "interval": ""
          }
        ],
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
      }
    ]
  }
}
